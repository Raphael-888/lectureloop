# Copy this file to .env and fill in your own values. Never commit .env.

# Model used for concept extraction, the agent planner, quiz generation, grading and explanations.
# LLM_PROVIDER: anthropic | openai | deepseek | offline (rule-based stand-in: no key, no cost, tests only)
LLM_PROVIDER=deepseek
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_S=60

# Only for C's scripts/run_vision.py (vision transcripts are not part of the upload flow yet).
DEEPSEEK_API_KEY=

# Agent
AGENT_PLANNER=llm              # llm = the model picks each next tool call; rules = deterministic policy only
MAX_ATTEMPTS_PER_CONCEPT=4     # questions on one concept before the agent moves on
ENABLE_SHORT_ANSWER=true       # false = multiple choice only

# Storage and uploads (paths are relative to backend/)
DB_PATH=data/lectureloop.sqlite3
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
MAX_PAGES=150
